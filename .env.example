# =============================================================================
# GraphRAG Multi-Hop QA — Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to source control.
# =============================================================================

# --- Neo4j -------------------------------------------------------------------
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your_neo4j_password_here
NEO4J_DATABASE=neo4j

# --- LLM Provider ------------------------------------------------------------
# Options: ollama | openai | anthropic | groq
LLM_PROVIDER=ollama

# Model name (depends on provider)
# Ollama examples : llama3.2, mistral, gemma2
# OpenAI examples : gpt-4o-mini, gpt-3.5-turbo
LLM_MODEL=llama3.2

# API keys (leave blank for Ollama)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=

# Ollama base URL (default for local install)
OLLAMA_BASE_URL=http://localhost:11434

# LLM temperature for extraction (lower = more deterministic)
LLM_TEMPERATURE=0.0

# Max retries for malformed LLM outputs
LLM_MAX_RETRIES=3

# --- Embeddings --------------------------------------------------------------
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# --- Cross-Encoder Reranking -------------------------------------------------
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANKER_ENABLED=true

# --- Retrieval Parameters ----------------------------------------------------
VECTOR_TOP_K=10
GRAPH_MAX_DEPTH=2
GRAPH_MAX_CANDIDATES=20
FINAL_CONTEXT_SIZE=5

# --- Entity Resolution -------------------------------------------------------
# Options: exact | fuzzy | embedding
ENTITY_RESOLUTION_MODE=fuzzy
ENTITY_FUZZY_THRESHOLD=0.85
ENTITY_EMBEDDING_THRESHOLD=0.90

# --- Dataset -----------------------------------------------------------------
DATASET_NAME=hotpotqa
DATASET_SAMPLE_SIZE=100
DATASET_RANDOM_SEED=42
DATA_DIR=data

# --- Experiment --------------------------------------------------------------
RESULTS_DIR=results
CACHE_DIR=data/cache
EXTRACTION_CACHE_ENABLED=true

# --- API / App ---------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
STREAMLIT_PORT=8501
LOG_LEVEL=INFO

# --- Cost Estimation (USD per 1K tokens, optional) ---------------------------
COST_INPUT_PER_1K=0.0
COST_OUTPUT_PER_1K=0.0

# --- Question Decomposition (optional extension) -----------------------------
QUESTION_DECOMPOSITION_ENABLED=false
